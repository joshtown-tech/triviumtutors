# Copy to .env.local and fill in. Everything is optional for local development:
# with nothing set, requests print to the terminal instead of being sent.

NEXT_PUBLIC_SITE_URL=https://triviumtutors.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@triviumtutors.com

# Team notifications (either one works, both is best: if one is down the other still carries the request)
RESEND_API_KEY=
MAIL_FROM="Trivium Tutors <hello@triviumtutors.com>"   # must be on a domain verified in Resend
MAIL_REPLY_TO=hello@triviumtutors.com
NOTIFY_EMAIL=you@example.com,partner@example.com        # comma separated, who gets each request
SLACK_WEBHOOK_URL=                                      # Slack incoming webhook

# Spam protection: Cloudflare Turnstile (free). Off until both are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI screening (Anthropic Claude). Without a key every request goes to the team flagged "review".
ANTHROPIC_API_KEY=
# Optional. Default is claude-opus-5-5 at low effort. claude-haiku-4-5 is cheaper and faster.
ANTHROPIC_MODEL=

# What the receipt email promises. Only change it if you will keep it.
RESPONSE_PROMISE="one business day"
# ANTHROPIC_BASE_URL=   # only for tests against a mock server

# Customer accounts (sign up and sign in). Server only. Off until SUPABASE_ANON_KEY is set.
# Use the project's "anon" "public" key, NEVER the service_role key.
SUPABASE_ANON_KEY=

# Supabase: a backup copy of every request (run supabase/001_requests.sql once). Server only, never NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
